# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Mypy / Ruff
.mypy_cache/
.ruff_cache/

# Experiment tracking & logs
wandb/
mlruns/
lightning_logs/
*.log

# Dataset archives and generated data (keep directory structure via .gitkeep)
# Raw archives stay local; users restore them by following README.md.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Model weights, embeddings, FAISS indices
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/indexes/*
!artifacts/indexes/.gitkeep
*.pt
*.pth
*.onnx
*.bin
*.index
